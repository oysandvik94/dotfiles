#!/usr/bin/env bash

set -euo pipefail

workmux_bin="${HOME}/dotfiles/dotfiles/scripts/workmux-local"

install_sidebar_hooks() {
    local sync_cmd reflow_cmd dirty_cmd

    sync_cmd="run-shell -b '${workmux_bin} _sidebar-sync --window #{window_id}'"
    reflow_cmd="run-shell -b '${workmux_bin} _sidebar-reflow --window #{window_id}'"
    dirty_cmd="run-shell -b 'kill -USR1 \$(tmux show-option -gqv @workmux_sidebar_daemon_pid) 2>/dev/null || true'"

    tmux set-hook -g 'after-new-window[99]' "${sync_cmd}" >/dev/null 2>&1 || true
    tmux set-hook -g 'after-new-session[99]' "${sync_cmd}" >/dev/null 2>&1 || true
    tmux set-hook -g 'window-resized[99]' "${reflow_cmd}" >/dev/null 2>&1 || true
    tmux set-hook -g 'after-select-window[98]' "${dirty_cmd}" >/dev/null 2>&1 || true
    tmux set-hook -g 'client-session-changed[98]' "${dirty_cmd}" >/dev/null 2>&1 || true
    tmux set-hook -g 'after-kill-pane[98]' "${dirty_cmd}" >/dev/null 2>&1 || true
}

default_resurrect_dir() {
    if [[ -d "${HOME}/.tmux/resurrect" ]]; then
        printf '%s\n' "${HOME}/.tmux/resurrect"
    else
        printf '%s\n' "${XDG_DATA_HOME:-${HOME}/.local/share}/tmux/resurrect"
    fi
}

resurrect_dir() {
    local configured
    configured="$(tmux show-option -gqv @resurrect-dir || true)"
    if [[ -n "${configured}" ]]; then
        configured="${configured//\$HOME/${HOME}}"
        configured="${configured//\~/${HOME}}"
        printf '%s\n' "${configured}"
    else
        default_resurrect_dir
    fi
}

last_resurrect_file() {
    readlink -f "$(resurrect_dir)/last"
}

write_sidebar_metadata() {
    local state_file="$1"
    local meta_file="${state_file}.workmux-sidebar.tsv"
    local scope tmp_file sidebar_windows total_windows sidebar_window_count

    sidebar_windows="$(
        tmux list-panes -a -F '#{session_name}\t#{window_index}\t#{@workmux_role}' \
            | awk -F '\t' '$3 == "sidebar" { print $1 "\t" $2 }' \
            | sort -u
    )"
    if [[ -z "${sidebar_windows}" ]]; then
        rm -f "${meta_file}"
        exit 0
    fi

    scope="$(tmux show-option -gqv @workmux_sidebar_scope || true)"
    total_windows="$(tmux list-windows -a 2>/dev/null | wc -l | tr -d ' ')"
    sidebar_window_count="$(printf '%s\n' "${sidebar_windows}" | sed '/^$/d' | wc -l | tr -d ' ')"

    tmp_file="$(mktemp)"
    trap 'rm -f "${tmp_file}"' EXIT

    if [[ "${scope}" == "global" || ( -z "${scope}" && "${sidebar_window_count}" -eq "${total_windows}" ) ]]; then
        printf 'scope\tglobal\n' >> "${tmp_file}"
    else
        printf 'scope\tsessions\n' >> "${tmp_file}"
        printf '%s\n' "${sidebar_windows}" \
            | cut -f1 \
            | sort -u \
            | while IFS= read -r session_name; do
                [[ -n "${session_name}" ]] || continue
                printf 'session\t%s\n' "${session_name}" >> "${tmp_file}"
            done
    fi

    printf '%s\n' "${sidebar_windows}" \
        | awk -F '\t' '{ print "window\t" $1 "\t" $2 }' >> "${tmp_file}"

    mv "${tmp_file}" "${meta_file}"
    trap - EXIT
}

restore_sidebar_metadata() {
    local state_file meta_file scope_mode
    state_file="$(last_resurrect_file)"
    [[ -n "${state_file}" ]] || exit 0

    meta_file="${state_file}.workmux-sidebar.tsv"
    [[ -f "${meta_file}" ]] || exit 0

    scope_mode="$(awk -F '\t' '$1 == "scope" { print $2; exit }' "${meta_file}")"
    [[ -n "${scope_mode}" ]] || exit 0

    tmux set-option -g @workmux_sidebar_enabled 1 >/dev/null 2>&1 || true

    if [[ "${scope_mode}" == "global" ]]; then
        tmux set-option -g @workmux_sidebar_scope global >/dev/null 2>&1 || true
    else
        local session_ids=""
        while IFS=$'\t' read -r kind session_name; do
            [[ "${kind}" == "session" ]] || continue
            local session_id=""
            session_id="$(tmux display-message -p -t "${session_name}" '#{session_id}' 2>/dev/null || true)"
            [[ -n "${session_id}" ]] || continue
            session_ids="${session_ids}${session_id} "
        done < "${meta_file}"

        session_ids="${session_ids%" "}"
        if [[ -n "${session_ids}" ]]; then
            tmux set-option -g @workmux_sidebar_scope "${session_ids}" >/dev/null 2>&1 || true
        else
            tmux set-option -gu @workmux_sidebar_scope >/dev/null 2>&1 || true
            exit 0
        fi
    fi

    install_sidebar_hooks

    while IFS=$'\t' read -r kind session_name window_index; do
        [[ "${kind}" == "window" ]] || continue
        local target="${session_name}:${window_index}"

        tmux list-panes -t "${target}" >/dev/null 2>&1 || continue

        if tmux list-panes -t "${target}" -F '#{@workmux_role}' 2>/dev/null | grep -qx 'sidebar'; then
            continue
        fi

        local pane_count
        pane_count="$(tmux list-panes -t "${target}" 2>/dev/null | wc -l | tr -d ' ')"
        if [[ "${pane_count}" -gt 1 ]]; then
            tmux kill-pane -t "${target}.1" >/dev/null 2>&1 || true
        fi

        local window_id=""
        window_id="$(tmux display-message -p -t "${target}" '#{window_id}' 2>/dev/null || true)"
        [[ -n "${window_id}" ]] || continue
        "${workmux_bin}" _sidebar-sync --window "${window_id}" >/dev/null 2>&1 || true
    done < "${meta_file}"
}

main() {
    local subcommand="${1:-}"
    case "${subcommand}" in
        save)
            write_sidebar_metadata "${2:?missing resurrect state file}"
            ;;
        restore)
            restore_sidebar_metadata
            ;;
        *)
            echo "Usage: $0 <save|restore> [state-file]" >&2
            exit 1
            ;;
    esac
}

main "$@"
