#!/bin/bash

# Define a path for storing the session token
SESSION_FILE="$HOME/.cache/op_session"

# Check if session token exists and is valid
if [[ -f "$SESSION_FILE" ]]; then
    eval $(cat "$SESSION_FILE")
    # Test if the session is still valid
    if ! op account list &>/dev/null; then
        rm "$SESSION_FILE"
    fi
fi

# If no valid session, prompt for login
if [[ ! -f "$SESSION_FILE" ]]; then
    # Use a headless login to cache the session
    eval $(op signin --raw >"$SESSION_FILE")
    eval $(cat "$SESSION_FILE")
fi

# Fetch list of items from 1Password and format for Rofi
items=$(op item list --format=json | jq -r '.[] | "\(.id) \(.title)"')

# Use Rofi to select an item
selected=$(echo "$items" | rofi -dmenu -i -p "1Password")

# Exit if no selection
[ -z "$selected" ] && exit 1

# Extract the item ID
item_id=$(echo "$selected" | awk '{print $1}')

# Fetch password for the selected item
password=$(op item get "$item_id" --field password --reveal)

# Copy the password to clipboard
echo -n "${password}" | wl-copy

# Notify the user
notify-send "1Password" "Password copied to clipboard!"
