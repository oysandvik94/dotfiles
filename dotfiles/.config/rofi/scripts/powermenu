#!/bin/sh

lock_label="  LOCK"
suspend_label="󰤄  SUSPEND"
reboot_label="  RESTART"
poweroff_label="  SHUTDOWN"

chosen=$(
    printf '%s\n' "$lock_label" "$suspend_label" "$reboot_label" "$poweroff_label" |
        rofi -dmenu \
            -theme "$HOME/.config/rofi/configs/power.rasi" \
            -mesg "SYSTEM // SESSION CONTROL" \
            -selected-row 0
) || exit 0

suspend_lock() {
    swayidle -w \
        timeout 1 'systemctl suspend' \
        resume 'killall -9 swayidle' \
        before-sleep 'swaylock -f -c 000000 -i ~/wallpapers/ting.png'
}

lock() {
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        swaylock --image "$HOME/wallpapers/ting.png"
    else
        i3lock --image "$HOME/wallpapers/ting.png"
    fi
}

case "$chosen" in
    "$lock_label") lock ;;
    "$suspend_label") suspend_lock ;;
    "$reboot_label") reboot ;;
    "$poweroff_label") poweroff ;;
esac
