configuration {
  modes: "window,drun,run,ssh";
  font: "JetBrainsMono Nerd Font 15";
  show-icons: false;
  drun-display-format: "{name}";
  display-drun: "›";
  display-window: "›";
  display-run: "›";
  display-ssh: "›";
}

@import "~/.config/rofi/themes/colors.rasi"

* {
  panel: #111622f2;
  panel-alt: #1c2232f2;
  selected: #293445;
  muted: #687288;
  text: #cdcdcd;
  bright: #f3f0ff;
  rose: #d2788c;
  cyan: #7894ab;
  urgent: #ea6962;
  transparent: #00000000;
}

window {
  fullscreen: true;
  transparency: "real";
  background-color: #090b12a8;
  padding: 26% 37% 39% 37%;
}

mainbox {
  children: [ inputbar, listview ];
  spacing: 12px;
  background-color: @transparent;
}

inputbar {
  children: [ prompt, entry, case-indicator ];
  padding: 16px 20px;
  border: 1px;
  border-color: #be8c8cb3;
  border-radius: 10px;
  background-color: @panel;
  text-color: @text;
}

prompt {
  padding: 0 12px 0 0;
  text-color: @rose;
}

entry {
  placeholder: "type to filter…";
  placeholder-color: @muted;
  text-color: @bright;
}

case-indicator {
  text-color: @muted;
}

listview {
  lines: 6;
  fixed-height: true;
  cycle: true;
  scrollbar: false;
  spacing: 2px;
  padding: 10px;
  border: 1px;
  border-color: #7894ab66;
  border-radius: 8px;
  background-color: @panel;
}

element {
  padding: 11px 14px;
  border: 0 0 0 3px;
  border-color: @transparent;
  border-radius: 5px;
  background-color: @transparent;
  text-color: @text;
}

element normal.normal,
element alternate.normal {
  background-color: @transparent;
  text-color: @text;
}

element selected.normal,
element selected.active,
element selected.urgent {
  border-color: @rose;
  background-color: @selected;
  text-color: @bright;
}

element normal.urgent,
element alternate.urgent {
  background-color: @transparent;
  text-color: @urgent;
}

element normal.active,
element alternate.active {
  background-color: @transparent;
  text-color: #8faf77;
}

element-text {
  background-color: inherit;
  text-color: inherit;
}
